rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == role)
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isCoach() {
      return hasRole('coach') || isAdmin();
    }

    function isParentOf(parentEmail) {
      return isAuthenticated() && (
        request.auth.token.email == parentEmail ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().email == parentEmail)
      );
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Athletes Collection (COPPA Protected)
    match /athletes/{athleteId} {
      allow read: if isCoach() || (isAuthenticated() && isParentOf(resource.data.parentEmail));
      allow write: if isCoach();
    }

    // Assessments Collection
    match /assessments/{assessmentId} {
      allow read: if isCoach() || (isAuthenticated() && (
        ('parent_email' in resource.data && isParentOf(resource.data.parent_email)) ||
        ('parentEmail' in resource.data && isParentOf(resource.data.parentEmail))
      ));
      allow write: if isCoach();
    }

    // Schedules Collection
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Invoices / Billing Collection
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isAuthenticated() && isParentOf(resource.data.parentEmail));
      allow write: if isAdmin();
    }

    // Coaches Collection
    match /coaches/{coachId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
