{
  "entities": {
    "users": {
      "title": "User Profiles & RBAC",
      "description": "User accounts with role assignments (admin, coach, parent) enforcing COPPA and data privacy limits",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "coach", "parent"] },
        "parentEmail": { "type": "string" },
        "childrenIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email", "role"]
    },
    "athletes": {
      "title": "Athletes (Youth Profiles)",
      "description": "COPPA-compliant athlete registrations with multi-sport enrollment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "dob": { "type": "string" },
        "parentEmail": { "type": "string" },
        "parentUid": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "coppaConsent": { "type": "boolean" },
        "coppaConsentDate": { "type": "string" },
        "sportsEnrolled": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sport": { "type": "string" },
              "monthlyFee": { "type": "number" }
            }
          }
        }
      },
      "required": ["id", "name", "parentEmail", "coppaConsent"]
    },
    "assessments": {
      "title": "Manual-First & AI-Ready Biomechanical Assessments",
      "description": "Multi-sport kinematics assessments supporting manual coach scoring and AI agentic processing pipelines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "athlete_id": { "type": "string" },
        "athlete_name": { "type": "string" },
        "parent_email": { "type": "string" },
        "sport": { "type": "string" },
        "exercise_type": { "type": "string" },
        "grading_rubric_sop": { "type": "string" },
        "coach_id": { "type": "string" },
        "coach_name": { "type": "string" },
        "data_source": {
          "type": "string",
          "enum": ["manual", "ai_agentic"],
          "default": "manual"
        },
        "quantitative_metrics": {
          "type": "object",
          "properties": {
            "valid_reps": { "type": "number" },
            "avg_depth_angle": { "type": "number" },
            "duration_seconds": { "type": "number" },
            "target_reps": { "type": "number" },
            "cadence_reps_per_minute": { "type": "number" }
          },
          "required": ["valid_reps", "duration_seconds"]
        },
        "qualitative_observations": {
          "type": "object",
          "properties": {
            "form_quality_score": { "type": "number" },
            "endurance_score": { "type": "number" },
            "fault_tags": { "type": "array", "items": { "type": "string" } },
            "coach_notes": { "type": "string" }
          },
          "required": ["form_quality_score", "endurance_score"]
        },
        "media_references": {
          "type": "object",
          "properties": {
            "video_storage_path": { "type": "string" },
            "smart_grid_processed": { "type": "boolean", "default": false },
            "thumbnail_url": { "type": "string" },
            "keypoints_json_path": { "type": "string" }
          }
        },
        "computed_score": { "type": "number" },
        "rubric_grade": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": [
        "id",
        "athlete_id",
        "sport",
        "exercise_type",
        "data_source",
        "quantitative_metrics",
        "qualitative_observations",
        "computed_score"
      ]
    },
    "schedules": {
      "title": "Court & Facility Reservations",
      "description": "Coach class schedules and court reservations with double-booking prevention",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "sport": { "type": "string" },
        "facility": { "type": "string" },
        "coachId": { "type": "string" },
        "coachName": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "maxCapacity": { "type": "number" },
        "enrolledCount": { "type": "number" }
      },
      "required": ["id", "title", "facility", "coachName", "timeSlot"]
    },
    "invoices": {
      "title": "Consolidated Family Invoices",
      "description": "Family billing ledger with automatic 10% sibling discount on lower cost registrations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentEmail": { "type": "string" },
        "parentUid": { "type": "string" },
        "parentName": { "type": "string" },
        "baseAmount": { "type": "number" },
        "siblingDiscount": { "type": "number" },
        "netTotal": { "type": "number" },
        "paymentSchedule": { "type": "string", "enum": ["upfront", "2-part", "monthly"] },
        "status": { "type": "string" }
      },
      "required": ["id", "parentEmail", "netTotal"]
    },
    "coaches": {
      "title": "Coach Performance Dashboard Metrics",
      "description": "Attendance tracking, churn risk indicators, and batch fill rate analytics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sports": { "type": "array", "items": { "type": "string" } },
        "attendanceRate": { "type": "number" },
        "churnRisk": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "retentionScore": { "type": "number" },
        "batchFillRate": { "type": "number" }
      },
      "required": ["id", "name"]
    }
  },
  "security": {
    "intent": "Role-based authorization architecture restricting youth medical/biometric and financial data in compliance with COPPA. Admins have full access, Coaches access profiles and schedules, Parents access only their children's data and consolidated family invoices."
  }
}
