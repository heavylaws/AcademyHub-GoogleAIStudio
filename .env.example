# --- Required runtime settings ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change_me_in_production"
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# --- AI pipeline settings ---
GEMINI_API_KEY="replace_with_your_gemini_key"
NEXT_PUBLIC_ENABLE_AI_PIPELINE="false"

# --- Database ---
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academyhub?schema=public"
# Docker Compose database service:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/academyhub?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academyhub?schema=public"

# Optional: used to override the default API host when running behind a reverse proxy.
# HOSTNAME="0.0.0.0"
# PORT="3000"
