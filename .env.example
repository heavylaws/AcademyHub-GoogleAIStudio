# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_ENABLE_AI_PIPELINE: Feature flag for biomechanics evaluation pipeline.
# If false (default), assessments use the deterministic scoring formula from manual coach inputs.
# If true, assessments route through the server-side Gemini multi-agent evaluation pipeline.
NEXT_PUBLIC_ENABLE_AI_PIPELINE="false"

# FIREBASE_SERVICE_ACCOUNT_KEY: (Option A) Raw JSON string of the Firebase Service Account key.
# Recommended for Cloud Run / Vercel / containerized environments where mounting a local JSON file is impractical.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# GOOGLE_APPLICATION_CREDENTIALS: (Option B) Absolute file path to service account JSON key file.
# Standard Google Cloud authentication used when running locally or with attached file mounts.
GOOGLE_APPLICATION_CREDENTIALS="/path/to/serviceAccountKey.json"

# DATABASE_URL: PostgreSQL connection string for Cloud SQL Postgres 15+ (me-central1) or local dev PostgreSQL.
# Direct TCP Connection (Local Dev / Direct Cloud SQL IP):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/academyhub?schema=public"
# Cloud SQL Auth Proxy / Unix Socket Connection (GCP Cloud Run deployment):
# DATABASE_URL="postgresql://user:password@localhost/academyhub?host=/cloudsql/project:me-central1:instance-id"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academyhub?schema=public"


